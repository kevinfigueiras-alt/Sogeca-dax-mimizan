# Copiez ce fichier en .env et remplissez les valeurs.
# .env ne doit JAMAIS être partagé ni mis sur GitHub (ajoutez-le à .gitignore).

# --- Supabase (base de données partagée) ---
# À récupérer dans Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Code d'accès au site ---
# Choisissez un code (chiffres/lettres). Toute personne qui le connaît peut
# ouvrir le site. Ce n'est pas un vrai système de comptes utilisateurs.
VITE_ACCESS_CODE=CHANGEZMOI
